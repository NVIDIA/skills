+++ b/tensorrt_llm/_torch/moe/fused_moe/configurable_moe.py
@@ -412,6 +412,17 @@ class ConfigurableMoE(MoE):
     def forward_impl(self, x, router_logits, **kwargs):
+        if isinstance(self.backend, CutlassMxfp8FusedMoE):
+            # MXFP8 needs smaller chunks and collects EPLB statistics per chunk.
+            num_chunks = max(1, x.shape[0] // 4096)
+            outputs = []
+            for x_chunk, logits_chunk in zip(x.chunk(num_chunks), router_logits.chunk(num_chunks)):
+                if self.layer_load_balancer is not None:
+                    self._load_balancer_update_statistic(logits_chunk)
+                outputs.append(self.backend.run_moe(x_chunk, logits_chunk, **kwargs))
+            self.repeat_idx = (self.repeat_idx + 1) % self.repeat_count
+            return torch.cat(outputs)
         output = self.scheduler.forward(x, router_logits, **kwargs)
         self.repeat_idx = (self.repeat_idx + 1) % self.repeat_count
         return output

