--- /dev/null
+++ b/tensorrt_llm/_torch/moe/fused_moe/cutlass/mxfp8.py
@@ -0,0 +1,30 @@
+import os
+
+from ....utils import get_sm_version
+from ..impl_contract import MoEEligibility, MoERejectReason
+from ..quantization import MXFP8FusedMoEMethod
+from .base import CutlassFusedMoEBase
+
+
+class CutlassMxfp8FusedMoE(CutlassFusedMoEBase):
+    """CUTLASS grouped GEMM with MXFP8 weights and activations."""
+
+    @classmethod
+    def can_implement(cls, p, d):
+        if p.quant_format != "mxfp8":
+            return MoEEligibility.reject(MoERejectReason.QUANT, "not MXFP8")
+        if get_sm_version() < 100:
+            return MoEEligibility.reject(MoERejectReason.HARDWARE, "needs SM100+")
+        if os.environ.get("TRTLLM_DISABLE_MXFP8_MOE", "0") == "1":
+            return MoEEligibility.reject(MoERejectReason.ENVIRONMENT, "disabled by env var")
+        try:
+            import mxfp8_grouped_gemm  # noqa: F401
+        except ImportError:
+            return MoEEligibility.reject(MoERejectReason.ENVIRONMENT, "kernel package missing")
+        return MoEEligibility.ok()
+
+    def _get_quant_method(self):
+        return MXFP8FusedMoEMethod()
+
+    def run_moe(self, x, token_selected_experts, token_final_scales, **kwargs):
+        return self._run_fused_moe_op(x, token_selected_experts, token_final_scales, **kwargs)

diff --git a/tensorrt_llm/_torch/moe/fused_moe/configurable_moe.py b/tensorrt_llm/_torch/moe/fused_moe/configurable_moe.py
