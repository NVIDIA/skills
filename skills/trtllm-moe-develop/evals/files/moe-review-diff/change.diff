+import pytest
+import torch
+
+from tensorrt_llm._torch.utils import get_sm_version
+
+
+@pytest.mark.skipif(get_sm_version() < 100, reason="skip")
+def test_mxfp8_cutlass_smoke():
+    moe = build_moe(backend="CUTLASS", quant="mxfp8", num_experts=8, top_k=2)
+    out = moe(torch.randn(16, 1024, device="cuda"), torch.randn(16, 8, device="cuda"))
+    assert out.shape == (16, 1024)
