     def _create_comm_strategy_auto(self):
+        if self.mapping.moe_ep_size >= 8 and os.environ.get("TRTLLM_MOE_RING") == "1":
+            return NvlinkRingComm(self.mapping, self.max_num_tokens, self.hidden_size)
         return CommunicationFactory.create_strategy(self, ...)
@@ -412,6 +415,9 @@ class ConfigurableMoE(MoE):
     def forward_impl(self, x, router_logits, **kwargs):
+        if isinstance(self.backend, MegaMoEImpl):
+            # this backend owns dispatch + GEMM + combine in one kernel
+            return self.backend._fused_dispatch_gemm_combine(x, router_logits, **kwargs)
         output = self.scheduler.forward(x, router_logits, **kwargs)

