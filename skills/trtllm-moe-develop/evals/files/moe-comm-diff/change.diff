# Synthetic, simplified diff prepared for a review exercise. It adds a new MoE
# communication strategy and wires a fused-communication MoE implementation into
# TensorRT-LLM. Helper names are abbreviated; hunk line numbers are illustrative.

diff --git a/tensorrt_llm/_torch/moe/fused_moe/communication/nvlink_ring.py b/tensorrt_llm/_torch/moe/fused_moe/communication/nvlink_ring.py
new file mode 100644
--- /dev/null
+++ b/tensorrt_llm/_torch/moe/fused_moe/communication/nvlink_ring.py
@@ -0,0 +1,22 @@
+from .base import Communication
+
+
+class NvlinkRingComm(Communication):
+    """Ring-based all-to-all over NVLink with a persistent native workspace."""
+
+    def __init__(self, mapping, max_num_tokens, hidden_size):
+        super().__init__(mapping)
+        self._workspace = allocate_ring_workspace(mapping, max_num_tokens, hidden_size)
+
+    def supports_post_quant_dispatch(self):
+        return True
+
+    def dispatch(self, hidden_states, token_selected_experts, token_final_scales, **kwargs):
+        return ring_dispatch(self._workspace, hidden_states, token_selected_experts,
+                             token_final_scales)
+
+    def combine(self, final_hidden_states, **kwargs):
+        return ring_combine(self._workspace, final_hidden_states)

