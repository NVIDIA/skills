{
  "$comment": "SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\nSPDX-License-Identifier: Apache-2.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Batch Scheduler Status",
  "description": "Standalone batch results. Worker completion, measured optimization and preservation are separate. Resume reuses done targets only when recorded input, runtime, parameters and output content still match.",
  "type": "object",
  "required": [
    "run_id",
    "started",
    "max_workers",
    "overall",
    "targets"
  ],
  "additionalProperties": true,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "started": {
      "type": "string"
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1
    },
    "cuda_available": {
      "type": "boolean",
      "description": "CUDA signal read from the setup preflight runtime_context (never from SO hasNvidiaGpu()). When false, gpu_bound targets are skipped (state skipped_gpu_unavailable), never silently entered into a long CPU fallback."
    },
    "overall": {
      "type": "object",
      "required": [
        "total",
        "done",
        "failed",
        "running",
        "queued"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "queued": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "state",
          "disposition"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "level": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "assembly",
              "component",
              "subcomponent",
              "detail",
              null
            ]
          },
          "archetype": {
            "type": [
              "string",
              "null"
            ]
          },
          "dep_group": {
            "type": "string",
            "enum": [
              "shared_first",
              "dependent_after",
              "independent"
            ]
          },
          "gpu_bound": {
            "type": "boolean"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "failed",
              "timeout",
              "skipped_gpu_unavailable",
              "blocked_dependency"
            ],
            "description": "'timeout' is a worker killed by its per-target/per-op wall-clock budget (subprocess.run timeout) \u2014 distinct from 'failed' (worker ran to a non-zero exit or failed to spawn). Distinguishing them surfaces the per-rule-timeout hang the scheduler exists to bound."
          },
          "disposition": {
            "type": "string",
            "enum": [
              "optimized",
              "no_op",
              "unknown",
              "verified_unchanged"
            ],
            "description": "Strict jobs derive outcomes from verified per-definition results. Legacy counts remain advisory; equal counts alone are no_op, never verified_unchanged."
          },
          "steps_applied": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "started": {
            "type": [
              "string",
              "null"
            ]
          },
          "ended": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Worker process return code; null on timeout or spawn failure."
          },
          "log_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "before": {
            "type": [
              "object",
              "null"
            ]
          },
          "after": {
            "type": [
              "object",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "resume_fingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_fingerprint": {
            "type": [
              "array",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "definition_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "memory_mb": {
                "type": "number",
                "minimum": 0
              },
              "gpu_slots": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "definition_results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "definition_id"
              ],
              "properties": {
                "definition_id": {
                  "type": "string"
                },
                "disposition": {
                  "type": "string"
                },
                "verification": {
                  "type": "object",
                  "properties": {
                    "passed": {
                      "type": "boolean"
                    }
                  }
                },
                "assessment": {
                  "type": "object",
                  "properties": {
                    "complete": {
                      "type": "boolean"
                    }
                  }
                },
                "before": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "after": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          },
          "result_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_mb": {
          "type": "number",
          "minimum": 0
        },
        "gpu_slots": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "object"
    }
  }
}
