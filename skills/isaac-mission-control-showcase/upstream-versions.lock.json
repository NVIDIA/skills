{
  "schema": "isaac-mission-control-showcase/upstream-versions@1",
  "description": "Runtime upstream pins. The skills below are owned by their own repositories and are resolved from pinned checkouts at runtime; they are never copied into this package.",
  "upstreams": {
    "mission_control": {
      "url": "https://github.com/nvidia-isaac/isaac_mission_control.git",
      "ref": "main",
      "commit": "5693ea727f5a6f3b2b1ac34f7191debfe49118bc",
      "skills_path": "skills",
      "checkout": "mission-control",
      "root_env": "MISSION_CONTROL_UPSTREAM_ROOT"
    },
    "isaac_sim": {
      "url": "https://github.com/isaac-sim/IsaacSim.git",
      "ref": "develop",
      "commit": "7c206f75bdadd9e05fc457f19863ca4c3f0cb693",
      "skills_path": "skills",
      "checkout": "omni-isaac-sim",
      "root_env": "ISAAC_SIM_UPSTREAM_ROOT"
    }
  },
  "skills": {
    "bring-up-cloud-stack": {
      "upstream": "mission_control",
      "path_env": "BRING_UP_CLOUD_STACK_SKILL_DIR",
      "entrypoints": {
        "up": "scripts/up.sh",
        "preflight": "scripts/preflight.sh"
      },
      "runner_env": {
        "up": "BRING_UP_CLOUD"
      },
      "resources": [
        "resources/docker-compose/bringup_services.yaml",
        "resources/docker-compose/.env",
        "resources/docker-compose/images.conf",
        "resources/docker-compose/init-db.sh"
      ],
      "adapter": "references/bring-up-cloud-stack/scripts/run.py",
      "primary_entrypoint": "up"
    },
    "change-map": {
      "upstream": "mission_control",
      "path_env": "CHANGE_MAP_SKILL_DIR",
      "entrypoints": {
        "set_map": "scripts/set_map.py"
      },
      "runner_env": {
        "set_map": "CHANGE_MAP"
      },
      "resources": [
        "resources/app/config/defaults.yaml"
      ],
      "adapter": "references/change-map/scripts/run.py",
      "primary_entrypoint": "set_map"
    },
    "change-fleet-composition": {
      "upstream": "mission_control",
      "path_env": "CHANGE_FLEET_COMPOSITION_SKILL_DIR",
      "entrypoints": {
        "set_fleet": "scripts/set_fleet.py"
      },
      "runner_env": {
        "set_fleet": "CHANGE_FLEET"
      },
      "resources": [
        "resources/app/config/defaults.yaml",
        "resources/docker-compose/bringup_services.yaml"
      ],
      "adapter": "references/change-fleet-composition/scripts/run.py",
      "primary_entrypoint": "set_fleet"
    },
    "isaac-sim-remote": {
      "upstream": "isaac_sim",
      "path_env": "ISAAC_SIM_REMOTE_SKILL_DIR",
      "entrypoints": {
        "send": "scripts/isaacsim_send.py"
      },
      "runner_env": {
        "send": "ISAAC_SEND"
      },
      "adapter": "references/isaac-sim-remote/scripts/run.py",
      "primary_entrypoint": "send"
    },
    "isaac-sim-installation": {
      "upstream": "isaac_sim",
      "path_env": "ISAAC_SIM_INSTALLATION_SKILL_DIR",
      "entrypoints": {
        "preflight": "scripts/preflight.py",
        "install_binary": "scripts/install_binary.py",
        "validate_install": "scripts/validate_install.py"
      },
      "agent_only": true,
      "note": "Read and followed by the agent when Isaac Sim is absent; the runner never invokes it.",
      "adapter": null
    }
  }
}
