{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.nvidia.com/tao/schemas/pas-action-request-v1.json",
  "title": "PAS DEFT platform action request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow",
    "platform",
    "name",
    "attempt",
    "label",
    "image_kind",
    "record_image",
    "workload_image",
    "passed_hf_token",
    "forward_env",
    "spec_bundle",
    "mounts",
    "environment",
    "virtualenv",
    "virtualenv_entrypoint_sha256",
    "virtualenv_shim",
    "results_dir",
    "stage_dir",
    "platform_runtime_dir",
    "status_path",
    "log_path",
    "fresh_outputs",
    "staging_absent_paths",
    "freshness_contract",
    "staging_receipt_path",
    "job_binding_path",
    "job_state_dir",
    "started_at",
    "started_ns",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "workflow": {"const": "tao-run-deft-pas"},
    "platform": {
      "enum": ["docker", "slurm", "kubernetes", "brev", "virtualenv"]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "label": {"type": "string", "pattern": "^(baseline|iter[1-9][0-9]*)$"},
    "image_kind": {"enum": ["pyt", "ds"]},
    "record_image": {"type": "string", "minLength": 1},
    "workload_image": {"type": "string", "minLength": 1},
    "passed_hf_token": {"type": "boolean"},
    "forward_env": {
      "type": "array",
      "uniqueItems": true,
      "items": {"const": "HF_TOKEN"},
      "maxItems": 1
    },
    "spec_bundle": {"type": "object"},
    "mounts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "read_only"],
        "properties": {
          "source": {"type": "string", "pattern": "^/"},
          "target": {"type": "string", "pattern": "^/"},
          "read_only": {"type": "boolean"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HOME", "PYTHONPATH", "HF_HOME", "XDG_CACHE_HOME"],
      "properties": {
        "HOME": {"type": "string", "pattern": "^/"},
        "PYTHONPATH": {"type": "string", "pattern": "^/"},
        "HF_HOME": {"type": "string", "pattern": "^/"},
        "XDG_CACHE_HOME": {"type": "string", "pattern": "^/"}
      }
    },
    "virtualenv": {"type": ["string", "null"]},
    "virtualenv_entrypoint_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "virtualenv_shim": {"type": "string", "pattern": "^/"},
    "results_dir": {"type": "string", "pattern": "^/"},
    "stage_dir": {"type": "string", "pattern": "^/"},
    "platform_runtime_dir": {"type": "string", "pattern": "^/"},
    "status_path": {"type": "string", "pattern": "^/"},
    "log_path": {"type": "string", "pattern": "^/"},
    "fresh_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "staging_absent_paths": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "freshness_contract": {
      "enum": [
        "local-mtime-after-prepare",
        "remote-mirror-with-delete-before-submit"
      ]
    },
    "staging_receipt_path": {"type": "string", "pattern": "^/"},
    "job_binding_path": {"type": "string", "pattern": "^/"},
    "job_state_dir": {"type": "string", "pattern": "^/"},
    "started_at": {"type": "string", "minLength": 1},
    "started_ns": {"type": "integer", "minimum": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"platform": {"const": "virtualenv"}}},
      "then": {
        "properties": {
          "virtualenv": {"type": "string", "pattern": "^/"},
          "virtualenv_entrypoint_sha256": {
            "type": "string", "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "virtualenv": {"type": "null"},
          "virtualenv_entrypoint_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"platform": {"const": "virtualenv"}}},
      "then": {
        "properties": {
          "freshness_contract": {"const": "local-mtime-after-prepare"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": {"enum": ["slurm", "kubernetes", "brev"]}
        }
      },
      "then": {
        "properties": {
          "freshness_contract": {
            "const": "remote-mirror-with-delete-before-submit"
          }
        }
      }
    }
  ]
}
